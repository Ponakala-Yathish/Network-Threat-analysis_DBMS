# Copy to .env:  cp .env.example .env
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=threat_intel

# Owner account. Used ONLY by the db:* scripts (migrate / seed / embed),
# because they create tables, functions and roles.
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Least-privilege account the web app logs in as. `npm run db:migrate`
# creates this role and sets this password. On every query the app switches
# (SET ROLE) to threat_admin or threat_analyst depending on who is logged in.
# Leave these out and the app falls back to DATABASE_USER (still switching role).
APP_DATABASE_USER=threat_app
APP_DATABASE_PASSWORD=threat_app_dev_password

# Optional: max pooled connections (default 10)
# DATABASE_POOL_MAX=10

# Required in production: at least 32 random characters
#   e.g.  openssl rand -base64 48
AUTH_SECRET=dev-secret-key-change-in-production-min-32-characters-long
