flowchart TD
    %% ==================== STRONG ENTITIES ====================
    EMPLOYEE([EMPLOYEE]):::strong-entity
    DEPARTMENT([DEPARTMENT]):::strong-entity
    PROJECT([PROJECT]):::strong-entity
    
    %% ==================== WEAK ENTITY ====================
    DEPENDENT[[DEPENDENT]]:::weak-entity

    %% ==================== EMPLOYEE ATTRIBUTES ====================
    E_Fname(((Fname))):::attribute
    E_Minit(((Minit))):::attribute
    E_Lname(((Lname))):::attribute
    E_Ssn(((Ssn))):::attribute
    E_Bdate(((Bdate))):::attribute
    E_Address(((Address))):::attribute
    E_Sex(((Sex))):::attribute
    E_Salary(((Salary))):::attribute
    E_Super_ssn(((Super_ssn))):::attribute
    E_Dno(((Dno))):::attribute

    %% ==================== DEPARTMENT ATTRIBUTES ====================
    D_Dname(((Dname))):::attribute
    D_Dnumber(((Dnumber))):::attribute
    D_Mgr_ssn(((Mgr_ssn))):::attribute
    D_Mgr_start_date(((Mgr_start_date))):::attribute

    %% ==================== PROJECT ATTRIBUTES ====================
    P_Pname(((Pname))):::attribute
    P_Pnumber(((Pnumber))):::attribute
    P_Plocation(((Plocation))):::attribute
    P_Dnum(((Dnum))):::attribute

    %% ==================== DEPENDENT ATTRIBUTES ====================
    Dep_Essn(((Essn))):::attribute
    Dep_Dependent_name(((Dependent_name))):::attribute
    Dep_Sex(((Sex))):::attribute
    Dep_Bdate(((Bdate))):::attribute
    Dep_Relationship(((Relationship))):::attribute

    %% ==================== RELATIONSHIPS ====================
    WORKS_FOR{WORKS_FOR}:::relationship
    MANAGES{MANAGES}:::relationship
    WORKS_ON{WORKS_ON}:::relationship
    SUPERVISION{SUPERVISION}:::relationship
    DEPENDENTS_OF{DEPENDENTS_OF}:::relationship

    %% ==================== RELATIONSHIP ATTRIBUTES ====================
    WF_Start_date(((Start_date))):::rel-attribute
    WF_Num_emp(((Number_of_employees))):::rel-attribute
    MG_Start_date(((Mgr_start_date))):::rel-attribute
    WO_Hours(((Hours))):::rel-attribute

    %% ==================== ENTITY-ATTRIBUTE CONNECTIONS ====================
    EMPLOYEE --- E_Fname
    EMPLOYEE --- E_Minit
    EMPLOYEE --- E_Lname
    EMPLOYEE --- E_Ssn
    EMPLOYEE --- E_Bdate
    EMPLOYEE --- E_Address
    EMPLOYEE --- E_Sex
    EMPLOYEE --- E_Salary
    EMPLOYEE --- E_Super_ssn
    EMPLOYEE --- E_Dno

    DEPARTMENT --- D_Dname
    DEPARTMENT --- D_Dnumber
    DEPARTMENT --- D_Mgr_ssn
    DEPARTMENT --- D_Mgr_start_date

    PROJECT --- P_Pname
    PROJECT --- P_Pnumber
    PROJECT --- P_Plocation
    PROJECT --- P_Dnum

    DEPENDENT --- Dep_Essn
    DEPENDENT --- Dep_Dependent_name
    DEPENDENT --- Dep_Sex
    DEPENDENT --- Dep_Bdate
    DEPENDENT --- Dep_Relationship

    %% ==================== ENTITY-RELATIONSHIP CONNECTIONS ====================
    EMPLOYEE -->|N| WORKS_FOR
    WORKS_FOR -->|1| DEPARTMENT

    EMPLOYEE -->|1| MANAGES
    MANAGES -->|1| DEPARTMENT

    EMPLOYEE -->|M| WORKS_ON
    WORKS_ON -->|N| PROJECT

    EMPLOYEE -->|1| SUPERVISION
    SUPERVISION -->|N| EMPLOYEE

    EMPLOYEE -->|1| DEPENDENTS_OF
    DEPENDENTS_OF -->|N| DEPENDENT

    %% ==================== RELATIONSHIP-ATTRIBUTE CONNECTIONS ====================
    WORKS_FOR --- WF_Start_date
    WORKS_FOR --- WF_Num_emp
    MANAGES --- MG_Start_date
    WORKS_ON --- WO_Hours

    %% ==================== STYLES ====================
    classDef strong-entity fill:#ffffff,stroke:#000000,stroke-width:3px,font-size:16px,font-weight:bold
    classDef weak-entity fill:#ffffff,stroke:#000000,stroke-width:3px,stroke-dasharray: 8 8,font-size:16px,font-weight:bold
    classDef attribute fill:#ffffff,stroke:#000000,stroke-width:2px,font-size:13px
    classDef rel-attribute fill:#ffffff,stroke:#000000,stroke-width:2px,font-size:12px
    classDef relationship fill:#e0e0e0,stroke:#000000,stroke-width:3px,font-size:15px,font-weight:bold

    linkStyle default stroke:#000000,stroke-width:2px